# Backend only. Copy to .env locally; set hosting secrets in production.
PORT=3000
HOST=127.0.0.1
APP_URL=https://store-ops.example.com
SHOPIFY_CLIENT_ID=replace-with-shopify-client-id
SHOPIFY_CLIENT_SECRET=replace-with-shopify-client-secret
SHOPIFY_API_VERSION=2026-10
SHOPIFY_SCOPES=read_products,write_products,read_orders,read_inventory
# 32 random bytes encoded as 64 hex characters; never rotate without migrating data.
TOKEN_ENCRYPTION_KEY=
# At least 32 random characters, distinct from agent tokens.
OPERATOR_TOKEN=
DATA_DIR=./data
# Optional one-time legacy registry import. Leave empty for a fresh admin console.
# After registry.enc exists, manage clients, stores and bots in the console.
ALLOWED_SHOPS=
# JSON array. token_sha256 is the SHA-256 hex digest of a random agent token.
# Each agent has separate store and tool permissions. Keep this value in secret storage.
AGENTS_JSON=[]
ENABLE_PRODUCT_WRITES=false
# Exact approved webhook receiver hostnames. Redirects, private DNS addresses,
# URL credentials, query-string secrets and HTTP destinations are rejected.
WEBHOOK_ALLOWED_HOSTS=
# MCP bridge configuration. Supply the raw token through the agent's environment.
STORE_OPS_URL=http://127.0.0.1:3000
STORE_OPS_AGENT_TOKEN=
