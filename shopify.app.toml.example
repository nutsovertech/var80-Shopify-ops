# Copy to shopify.app.toml after registering the app in Shopify Dev Dashboard.
# This example is not a registered app and contains no credentials.
client_id = "REPLACE_WITH_SHOPIFY_CLIENT_ID"
name = "Var80 Store Ops"
application_url = "https://store-ops.example.com"
embedded = false

[access_scopes]
scopes = "read_products,write_products,read_orders,read_inventory"

[auth]
redirect_urls = ["https://store-ops.example.com/auth/callback"]

[webhooks]
api_version = "2026-10"

[[webhooks.subscriptions]]
topics = ["app/uninstalled"]
uri = "/webhooks"
